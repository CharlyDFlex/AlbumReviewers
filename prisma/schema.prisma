// Prisma is used in this project only to apply and evolve the database
// schema (via `prisma db push`). At runtime the Next.js app talks to
// Postgres through the Supabase client (see src/lib/supabase/), so that
// Row Level Security policies are enforced — Prisma Client is not used
// there. See prisma/rls-and-seed.sql for everything a declarative Prisma
// schema can't express (RLS policies, triggers, seed data).

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

model Profile {
  id          String   @id @db.Uuid
  username    String   @unique
  displayName String?  @map("display_name")
  avatarUrl   String?  @map("avatar_url")
  bio         String?
  // 'discjockey' accounts can add albums to the catalog by hand (cover,
  // tracklist, track durations) from /albums/nouveau. Granted by the
  // handle_discjockey_request_review trigger when a request below is
  // approved by hand in the Supabase dashboard. The `role in (...)` check
  // lives in rls-and-seed.sql (Prisma can't declare check constraints in
  // this version).
  role        String   @default("user")
  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  albumRatings       AlbumRating[]
  trackRatings       TrackRating[]
  listens            Listen[]
  watchlist          Watchlist[]
  playlists          Playlist[]
  spotifyConnection  SpotifyConnection?
  discjockeyRequests DiscjockeyRequest[]

  @@map("profiles")
}

model Artist {
  id        String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  name      String
  imageUrl  String?  @map("image_url")
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  albums Album[]

  @@map("artists")
}

model Album {
  id           String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  artistId     String    @map("artist_id") @db.Uuid
  title        String
  coverUrl     String?   @map("cover_url")
  releaseDate  DateTime? @map("release_date") @db.Date
  description  String?
  genre        String?
  // Denormalized, kept in sync by the update_album_rating_stats trigger
  // (see prisma/rls-and-seed.sql) — lets every catalog sort, including
  // "popularity", paginate with a plain indexed ORDER BY.
  ratingsCount Int       @default(0) @map("ratings_count")
  avgRating    Decimal?  @map("avg_rating") @db.Decimal(3, 2)
  createdAt    DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)

  artist       Artist        @relation(fields: [artistId], references: [id], onDelete: Cascade)
  tracks       Track[]
  albumRatings AlbumRating[]
  listens      Listen[]
  watchlist    Watchlist[]

  @@index([artistId])
  @@index([createdAt(sort: Desc)])
  @@index([genre])
  @@index([ratingsCount(sort: Desc)])
  @@map("albums")
}

model Track {
  id              String @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  albumId         String @map("album_id") @db.Uuid
  trackNumber     Int    @map("track_number")
  title           String
  durationSeconds Int?   @map("duration_seconds")

  album        Album         @relation(fields: [albumId], references: [id], onDelete: Cascade)
  trackRatings TrackRating[]

  @@unique([albumId, trackNumber])
  @@index([albumId])
  @@map("tracks")
}

/// One rating/review per user per album (edit-in-place, mirrors a Letterboxd film rating).
model AlbumRating {
  id        String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId    String   @map("user_id") @db.Uuid
  albumId   String   @map("album_id") @db.Uuid
  rating    Decimal? @db.Decimal(2, 1)
  review    String?
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime @default(now()) @map("updated_at") @db.Timestamptz(6)

  profile Profile @relation(fields: [userId], references: [id], onDelete: Cascade)
  album   Album   @relation(fields: [albumId], references: [id], onDelete: Cascade)

  @@unique([userId, albumId])
  @@index([albumId])
  @@index([userId])
  @@map("album_ratings")
}

/// One rating per user per track.
model TrackRating {
  id        String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId    String   @map("user_id") @db.Uuid
  trackId   String   @map("track_id") @db.Uuid
  rating    Decimal  @db.Decimal(2, 1)
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime @default(now()) @map("updated_at") @db.Timestamptz(6)

  profile Profile @relation(fields: [userId], references: [id], onDelete: Cascade)
  track   Track   @relation(fields: [trackId], references: [id], onDelete: Cascade)

  @@unique([userId, trackId])
  @@index([trackId])
  @@map("track_ratings")
}

/// Diary: every time a user logs a listen (can log the same album more than once).
model Listen {
  id         String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId     String   @map("user_id") @db.Uuid
  albumId    String   @map("album_id") @db.Uuid
  listenedAt DateTime @default(now()) @map("listened_at") @db.Date
  createdAt  DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  profile Profile @relation(fields: [userId], references: [id], onDelete: Cascade)
  album   Album   @relation(fields: [albumId], references: [id], onDelete: Cascade)

  @@index([userId, listenedAt(sort: Desc)])
  @@index([albumId])
  @@map("listens")
}

/// Backlog / "want to listen" list.
model Watchlist {
  id        String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId    String   @map("user_id") @db.Uuid
  albumId   String   @map("album_id") @db.Uuid
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  profile Profile @relation(fields: [userId], references: [id], onDelete: Cascade)
  album   Album   @relation(fields: [albumId], references: [id], onDelete: Cascade)

  @@unique([userId, albumId])
  @@index([userId])
  @@map("watchlist")
}

/// A link to a playlist a user has built on an external streaming platform
/// (spotify/deezer/itunes). Either pasted by hand (externalId stays at its
/// random default) or imported from a connected Spotify account (externalId
/// = the real playlist id, so re-importing upserts instead of duplicating).
/// The `platform in (...)` check constraint lives in rls-and-seed.sql since
/// Prisma can't declare check constraints in this version.
model Playlist {
  id         String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId     String   @map("user_id") @db.Uuid
  platform   String
  url        String
  title      String?
  externalId String   @default(dbgenerated("gen_random_uuid()::text")) @map("external_id")
  createdAt  DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  profile Profile @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, platform, externalId])
  @@index([userId, createdAt(sort: Desc)])
  @@map("playlists")
}

/// Tokens for a user's connected Spotify account, used to import their
/// playlists into Playlist rows. Never publicly readable — see the
/// owner-only RLS policy in rls-and-seed.sql.
model SpotifyConnection {
  userId        String   @id @map("user_id") @db.Uuid
  spotifyUserId String   @map("spotify_user_id")
  accessToken   String   @map("access_token")
  refreshToken  String   @map("refresh_token")
  expiresAt     DateTime @map("expires_at") @db.Timestamptz(6)
  createdAt     DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt     DateTime @default(now()) @map("updated_at") @db.Timestamptz(6)

  profile Profile @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("spotify_connections")
}

/// A request from a user to be granted the 'discjockey' role. Reviewed by
/// hand in the Supabase dashboard (flip `status` to 'approved'/'rejected')
/// — approving one grants the role via a trigger, see rls-and-seed.sql.
/// The `status in (...)` check and the one-pending-request-per-user index
/// also live there (not expressible declaratively here).
model DiscjockeyRequest {
  id         String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId     String    @map("user_id") @db.Uuid
  status     String    @default("pending")
  message    String?
  createdAt  DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  reviewedAt DateTime? @map("reviewed_at") @db.Timestamptz(6)

  profile Profile @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, createdAt(sort: Desc)])
  @@map("discjockey_requests")
}
