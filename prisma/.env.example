# Copy to prisma/.env (git-ignored). prisma.config.ts loads this file so
# the Prisma CLI (db push, db execute, studio...) can find DATABASE_URL —
# it's kept separate from the app's own .env.local.
#
# Find this in Supabase: Project Settings -> Database -> Connection string.
# Use the "Session pooler" (port 5432) — schema changes (db push) and raw
# SQL (db execute) need a direct, non-transaction-pooled connection.

DATABASE_URL="postgresql://postgres.<project-ref>:<password>@<pooler-host>:5432/postgres"
